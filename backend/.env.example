# EclipSec CTF Backend Environment Configuration

# Service settings
PROJECT_NAME="EclipSec CTF API"
ENVIRONMENT="production"

# Database Connection (In Railway, automatically provided by Railway PostgreSQL plugin)
DATABASE_URL="postgresql+asyncpg://postgres:password@host:port/railway"

# JWT Secret Key (Generate a secure 32+ character random string)
JWT_SECRET="generate-a-secure-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated for Vercel and local dev)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://eclipsec.cl,https://www.eclipsec.cl"
CORS_ORIGIN_REGEX="^https:\/\/.*\.vercel\.app$"

# Initial Admin Credentials (Created on first run)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@eclipsec.cl"
ADMIN_PASSWORD="superadminpassword123"
