PROJECT_NAME="CTF Platform API (Example)"
ENVIRONMENT="development"

DATABASE_URL="postgresql+asyncpg://example_db_user:example_db_password@db.example.local:5432/ctf_example_db"

JWT_SECRET="example_jwt_secret_replace_with_32_plus_random_chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS="http://localhost:3000,https://portal.example.test"
CORS_ORIGIN_REGEX=""

CHALLENGES_BASE_URL="https://challenges.example.test"
CHALLENGES_REPOSITORY="example-org/example-ctf-challenges"

ADMIN_USERNAME="example_admin"
ADMIN_EMAIL="example-admin@example.test"
ADMIN_PASSWORD="example_admin_password_replace_me"
